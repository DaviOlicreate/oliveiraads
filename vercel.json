{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "Site 100% estático: sem build e sem servidor. O modo estático vem do Framework Preset = 'Other', configurado no painel da Vercel (Settings > Build and Deployment). Se algum dia o build falhar com 'No entrypoint found', é esse preset que voltou para Node.",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
